# Copy this file to .env and fill in real values before running docker compose.
# .env is already gitignored - never commit real secrets.

# --- MySQL (used by all 3 per-service databases: user-db, product-db, order-db) ---
MYSQL_ROOT_PASSWORD=change-me-to-a-strong-password

# --- JWT ---
# Generate a real secret, e.g.: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRATION=86400000

# --- CORS ---
# Comma separated list of origins the frontend is served from
CORS_ALLOWED_ORIGINS=http://localhost

# --- JPA ---
# Keep as "validate" once the schema is stable. Only use "update" in local, throwaway dev.
JPA_DDL_AUTO=validate

# --- Frontend build ---
# Leave empty to use the nginx reverse proxy (default, recommended for docker compose)
REACT_APP_API_BASE_URL=

# --- Image tag (used by build/push scripts) ---
TAG=local

# --- Service mesh (all of these have working defaults in docker-compose.yml already;
#     only override if you're running a service outside compose, e.g. from your IDE) ---
# EUREKA_URI=http://localhost:8761/eureka/
# CONFIG_SERVER_URI=http://localhost:8888
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# REDIS_HOST=localhost
# REDIS_PORT=6379
